	(text "Mutex Counter"
		(exclude_from_sim no)
		(at 221.996 51.562 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1446ea4b-45aa-43db-908c-f739c86ff029")
	)
	(text "If a CPU is accessing the mutex counter for\nread-modify-write, disable the other CPU."
		(exclude_from_sim no)
		(at 75.438 61.976 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3e368a0a-b634-4daa-8e7f-2ea23a78b073")
	)
	(text "mutex_init:\n    lda #$ff\n    sta $8000\n    rts\n\nmutex_lock:\n    inc $8000\n    beq mutex_locked\n    dec $8000\n    jmp mutex_lock\nmutex_locked:\n    rts\n\nmutex_unlock:\n    dec $8000\n    rts"
		(exclude_from_sim no)
		(at 24.384 40.386 0)
		(effects
			(font
				(face "Courier")
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left)
		)
		(uuid "d46a6133-472f-45ae-b64e-2e5920ab653f")
	)
