	(text "CPU2_BUSEN"
		(exclude_from_sim no)
		(at 73.914 138.176 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c3bfcd8e-5115-498f-8c10-7591daa096e6")
	)
	(text "MAIN_CLK (12MHz) is divided by 6 to create CPU1_CLK and CPU2_CLK (2MHz).\nAlso divided by 6 to generate bus enables CPU1_BUSEN and CPU2_BUSEN.\n\nCPU1 can access the common bus only when CPU1_BUSEN is high and\nCPU2 can access the common bus only when CPU2_BUSEN is high.\n\nBus enables are longer than clock pulses to allow the CPU's to set up the\nnext bus address prior to the rising edge and to maintain R/~{W} stability.\n\nBus enables may be stretched if mutual exclusion is in progress on the CPU,\nwhich is effected by disabling the RDY signal to the other CPU.\n\nCOMMON_CLK can be used to gate access to daughter chips on either clock."
		(exclude_from_sim no)
		(at 184.15 125.73 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c91d9143-1137-4e62-bd16-3df715c968b3")
	)
	(text "CPU1_CLK"
		(exclude_from_sim no)
		(at 74.93 115.57 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e455da7e-5bd2-4b9e-9493-61e2c7c5983e")
	)
